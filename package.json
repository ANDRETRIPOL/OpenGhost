{
  "name": "openghost",
  "productName": "OpenGhost",
  "version": "1.4.6",
  "private": true,
  "description": "OpenGhost",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "shortcut": "electron . --create-shortcut",
    "dist": "electron-builder --win nsis --publish never",
    "dist:mac": "electron-builder --mac dmg --universal --publish never",
    "dist:linux": "electron-builder --linux tar.gz --publish never"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.openghost.app",
    "productName": "OpenGhost",
    "icon": "desktop/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!images/**",
      "!.github/**",
      "!**/*.md"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenGhost",
      "artifactName": "OpenGhost-${version}-Setup.exe",
      "uninstallDisplayName": "OpenGhost"
    },
    "mac": {
      "target": "dmg",
      "icon": "desktop/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "OpenGhost-${version}-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDesktopFolderUsageDescription": "The agent works with the files in this place when you ask it to.",
        "NSDocumentsFolderUsageDescription": "The agent works with the files in this place when you ask it to.",
        "NSDownloadsFolderUsageDescription": "The agent works with the files in this place when you ask it to.",
        "NSRemovableVolumesUsageDescription": "The agent works with the files in this place when you ask it to.",
        "NSNetworkVolumesUsageDescription": "The agent works with the files in this place when you ask it to.",
        "NSAppleEventsUsageDescription": "The agent asks other apps to do things when a task you gave it needs them."
      }
    },
    "linux": {
      "target": "tar.gz",
      "icon": "desktop/icon.png",
      "category": "Utility",
      "artifactName": "OpenGhost-${version}-linux.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0"
  }
}
