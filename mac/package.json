{
  "name": "openghost",
  "productName": "OpenGhost",
  "version": "1.0.1",
  "private": true,
  "description": "OpenGhost",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "shortcut": "electron . --create-shortcut",
    "dist": "electron-builder --mac dmg --universal"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.openghost.app",
    "productName": "OpenGhost",
    "icon": "desktop/icon.ico",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!**/*.md"
    ],
    "asar": true,
    "mac": {
      "target": "dmg",
      "icon": "desktop/icon.png",
      "category": "public.app-category.utilities",
      "artifactName": "OpenGhost-1.0.1-mac.${ext}",
      "identity": null
    },
    "win": {
      "target": "nsis",
      "icon": "desktop/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "OpenGhost",
      "artifactName": "OpenGhost-1.0.1-Setup.exe",
      "uninstallDisplayName": "OpenGhost"
    }
  }
}
